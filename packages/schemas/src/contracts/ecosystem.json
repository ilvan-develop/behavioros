{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://behavioros.io/schemas/contracts/ecosystem.json",
  "title": "Ecosystem Contracts",
  "description": "JSON Schema for all BehaviorOS ecosystem contract types: PluginLifecycle, DigitalTwin, Tenant/Workspace, Billing, SDKGenerator, CLI, Registry, Marketplace",
  "type": "object",
  "definitions": {
    "PluginManifest": {
      "type": "object",
      "title": "PluginManifest",
      "description": "A plugin manifest describing metadata and dependencies",
      "properties": {
        "id": { "type": "string", "description": "Unique plugin identifier" },
        "name": { "type": "string", "description": "Human-readable plugin name" },
        "version": {
          "type": "string",
          "description": "Plugin version (semver)",
          "examples": ["1.0.0"]
        },
        "description": { "type": "string", "description": "Short description of the plugin" },
        "author": { "type": "string", "description": "Plugin author" },
        "dependencies": {
          "type": "array",
          "description": "Plugin dependencies",
          "items": {
            "type": "object",
            "properties": {
              "pluginId": { "type": "string" },
              "version": { "type": "string" }
            },
            "required": ["pluginId", "version"]
          }
        },
        "minEngineVersion": {
          "type": "string",
          "description": "Minimum required BehaviorOS engine version"
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required permissions"
        },
        "hooks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Plugin lifecycle hooks"
        }
      },
      "required": ["id", "name", "version"]
    },
    "PluginStatus": {
      "type": "string",
      "title": "PluginStatus",
      "description": "Lifecycle status of a plugin",
      "enum": ["registered", "loading", "loaded", "enabled", "disabled", "error", "unloaded"]
    },
    "PluginInstance": {
      "type": "object",
      "title": "PluginInstance",
      "description": "A runtime instance of a registered plugin",
      "properties": {
        "manifest": { "$ref": "#/definitions/PluginManifest" },
        "status": { "$ref": "#/definitions/PluginStatus" },
        "loadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the plugin was loaded"
        },
        "enabledAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the plugin was enabled"
        },
        "error": {
          "type": "string",
          "description": "Error message if the plugin is in error status"
        },
        "exports": {
          "type": "object",
          "description": "Plugin exports (APIs exposed by the plugin)",
          "additionalProperties": true
        }
      },
      "required": ["manifest", "status"]
    },
    "TwinState": {
      "type": "object",
      "title": "TwinState",
      "description": "A snapshot of a digital twin's state",
      "properties": {
        "id": { "type": "string", "description": "Unique twin state identifier" },
        "entityId": {
          "type": "string",
          "description": "Identifier of the real-world entity being twinned"
        },
        "snapshot": {
          "type": "object",
          "description": "State snapshot data",
          "additionalProperties": true
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of this snapshot"
        },
        "version": { "type": "integer", "description": "Monotonic version counter" }
      },
      "required": ["id", "entityId", "snapshot", "timestamp", "version"]
    },
    "SimulationConfig": {
      "type": "object",
      "title": "SimulationConfig",
      "description": "Configuration for running a digital twin simulation",
      "properties": {
        "id": { "type": "string", "description": "Unique simulation configuration identifier" },
        "name": { "type": "string", "description": "Simulation name" },
        "steps": { "type": "integer", "minimum": 1, "description": "Number of simulation steps" },
        "interval": {
          "type": "integer",
          "minimum": 0,
          "description": "Interval between steps in milliseconds"
        },
        "initialState": {
          "type": "object",
          "description": "Initial state of the simulation",
          "additionalProperties": true
        },
        "rules": {
          "type": "array",
          "description": "Simulation rules (condition → action)",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "condition": { "type": "string", "examples": ["cpu > 80"] },
              "action": { "type": "string", "examples": ["replicas += 1"] }
            },
            "required": ["name", "condition", "action"]
          }
        }
      },
      "required": ["id", "name", "steps", "interval", "initialState", "rules"]
    },
    "SimulationResult": {
      "type": "object",
      "title": "SimulationResult",
      "description": "The result of a completed simulation run",
      "properties": {
        "id": { "type": "string", "description": "Unique result identifier" },
        "configId": { "type": "string", "description": "ID of the simulation config used" },
        "steps": {
          "type": "array",
          "description": "Sequence of simulation step states",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "integer" },
              "state": { "type": "object", "additionalProperties": true },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["step", "state", "timestamp"]
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when simulation started"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when simulation completed"
        },
        "summary": {
          "type": "object",
          "description": "Simulation summary data",
          "additionalProperties": true
        }
      },
      "required": ["id", "configId", "steps", "startedAt", "completedAt", "summary"]
    },
    "Forecast": {
      "type": "object",
      "title": "Forecast",
      "description": "A forecast prediction for a single metric",
      "properties": {
        "id": { "type": "string", "description": "Unique forecast identifier" },
        "metric": { "type": "string", "description": "Name of the forecast metric" },
        "currentValue": { "type": "number", "description": "Current actual value" },
        "predictedValues": {
          "type": "array",
          "description": "Predicted values for future periods",
          "items": {
            "type": "object",
            "properties": {
              "period": { "type": "string", "examples": ["t+1"] },
              "value": { "type": "number" }
            },
            "required": ["period", "value"]
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Forecast confidence score (0-1)"
        },
        "trend": {
          "type": "string",
          "enum": ["up", "down", "stable"],
          "description": "Predicted trend direction"
        }
      },
      "required": ["id", "metric", "currentValue", "predictedValues", "confidence", "trend"]
    },
    "ChaosExperiment": {
      "type": "object",
      "title": "ChaosExperiment",
      "description": "A chaos engineering experiment definition",
      "properties": {
        "id": { "type": "string", "description": "Unique experiment identifier" },
        "name": { "type": "string", "description": "Experiment name" },
        "faultType": {
          "type": "string",
          "description": "Type of fault to inject",
          "enum": ["latency", "error", "crash", "resource-exhaustion"]
        },
        "target": { "type": "string", "description": "Target resource or service for the fault" },
        "intensity": { "type": "number", "minimum": 0, "description": "Fault intensity level" },
        "duration": {
          "type": "integer",
          "minimum": 0,
          "description": "Experiment duration in milliseconds"
        },
        "active": { "type": "boolean", "description": "Whether the experiment is currently active" }
      },
      "required": ["id", "name", "faultType", "target", "intensity", "duration", "active"]
    },
    "Tenant": {
      "type": "object",
      "title": "Tenant",
      "description": "A multi-tenant organization in the system",
      "properties": {
        "id": { "type": "string", "description": "Unique tenant identifier" },
        "name": { "type": "string", "description": "Tenant/Organization name" },
        "slug": { "type": "string", "description": "URL-friendly slug for the tenant" },
        "plan": { "type": "string", "description": "Assigned pricing plan ID" },
        "status": {
          "type": "string",
          "description": "Tenant account status",
          "enum": ["active", "suspended", "cancelled"]
        },
        "quotas": {
          "type": "object",
          "description": "Resource quotas keyed by resource name",
          "additionalProperties": { "type": "number" }
        },
        "usage": {
          "type": "object",
          "description": "Current resource usage keyed by resource name",
          "additionalProperties": { "type": "number" }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        },
        "metadata": {
          "type": "object",
          "description": "Optional arbitrary metadata",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "name",
        "slug",
        "plan",
        "status",
        "quotas",
        "usage",
        "createdAt",
        "updatedAt"
      ]
    },
    "Workspace": {
      "type": "object",
      "title": "Workspace",
      "description": "A workspace within a tenant, containing projects and members",
      "properties": {
        "id": { "type": "string", "description": "Unique workspace identifier" },
        "tenantId": { "type": "string", "description": "ID of the owning tenant" },
        "name": { "type": "string", "description": "Workspace name" },
        "slug": { "type": "string", "description": "URL-friendly slug" },
        "description": { "type": "string", "description": "Workspace description" },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Member user IDs"
        },
        "config": {
          "type": "object",
          "description": "Workspace configuration",
          "additionalProperties": true
        },
        "status": {
          "type": "string",
          "description": "Workspace status",
          "enum": ["active", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        }
      },
      "required": [
        "id",
        "tenantId",
        "name",
        "slug",
        "members",
        "config",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PricingModel": {
      "type": "string",
      "title": "PricingModel",
      "description": "Supported pricing models",
      "enum": ["flat", "per-unit", "tiered", "mixed"]
    },
    "PricingPlan": {
      "type": "object",
      "title": "PricingPlan",
      "description": "A pricing plan defining billing terms for a tenant",
      "properties": {
        "id": { "type": "string", "description": "Unique plan identifier" },
        "name": { "type": "string", "description": "Plan name" },
        "model": { "$ref": "#/definitions/PricingModel" },
        "flatFee": {
          "type": "number",
          "minimum": 0,
          "description": "Flat fee amount (for flat/mixed models)"
        },
        "unitPrice": {
          "type": "number",
          "minimum": 0,
          "description": "Per-unit price (for per-unit/mixed models)"
        },
        "tiers": {
          "type": "array",
          "description": "Pricing tiers (for tiered model)",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "integer", "minimum": 0 },
              "to": { "type": "integer", "minimum": 0 },
              "unitPrice": { "type": "number", "minimum": 0 }
            },
            "required": ["from", "unitPrice"]
          }
        },
        "billingPeriod": {
          "type": "string",
          "description": "Billing cycle",
          "enum": ["monthly", "annual"]
        },
        "includedUnits": {
          "type": "object",
          "description": "Free included units per resource",
          "additionalProperties": { "type": "number" }
        }
      },
      "required": ["id", "name", "model", "billingPeriod"]
    },
    "UsageRecord": {
      "type": "object",
      "title": "UsageRecord",
      "description": "A record of resource usage by a tenant",
      "properties": {
        "tenantId": { "type": "string", "description": "Tenant that incurred the usage" },
        "resource": { "type": "string", "description": "Resource type consumed" },
        "quantity": { "type": "number", "minimum": 0, "description": "Quantity consumed" },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of usage"
        }
      },
      "required": ["tenantId", "resource", "quantity", "timestamp"]
    },
    "Invoice": {
      "type": "object",
      "title": "Invoice",
      "description": "A generated invoice for a tenant's billing period",
      "properties": {
        "id": { "type": "string", "description": "Unique invoice identifier" },
        "tenantId": { "type": "string", "description": "Tenant being billed" },
        "planId": { "type": "string", "description": "Pricing plan used for this invoice" },
        "period": {
          "type": "object",
          "description": "Billing period",
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          },
          "required": ["start", "end"]
        },
        "items": {
          "type": "array",
          "description": "Line items on the invoice",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number", "minimum": 0 },
              "unitPrice": { "type": "number", "minimum": 0 },
              "total": { "type": "number", "minimum": 0 }
            },
            "required": ["description", "quantity", "unitPrice", "total"]
          }
        },
        "subtotal": { "type": "number", "minimum": 0, "description": "Invoice subtotal" },
        "discounts": { "type": "number", "minimum": 0, "description": "Total discounts applied" },
        "total": { "type": "number", "minimum": 0, "description": "Invoice total after discounts" },
        "status": {
          "type": "string",
          "description": "Invoice payment status",
          "enum": ["draft", "sent", "paid", "overdue"]
        },
        "dueDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 payment due date"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        }
      },
      "required": [
        "id",
        "tenantId",
        "planId",
        "period",
        "items",
        "subtotal",
        "discounts",
        "total",
        "status",
        "dueDate",
        "createdAt"
      ]
    },
    "Language": {
      "type": "string",
      "title": "Language",
      "description": "Supported SDK generation target languages",
      "enum": ["typescript", "python", "go", "java", "rust", "csharp", "ruby", "php"]
    },
    "SDKConfig": {
      "type": "object",
      "title": "SDKConfig",
      "description": "Configuration for generating a multi-language SDK",
      "properties": {
        "name": { "type": "string", "description": "SDK package name" },
        "version": { "type": "string", "description": "SDK version (semver)" },
        "description": { "type": "string", "description": "SDK description" },
        "language": { "$ref": "#/definitions/Language" },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "description": "Base URL for API endpoints"
        },
        "packageManager": {
          "type": "string",
          "description": "Package manager for the target language"
        },
        "endpoints": {
          "type": "array",
          "description": "API endpoint definitions",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
              "operationId": { "type": "string" },
              "summary": { "type": "string" },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "required": { "type": "boolean" },
                    "location": { "type": "string", "enum": ["query", "path", "header", "body"] }
                  },
                  "required": ["name", "type", "required", "location"]
                }
              },
              "responseType": { "type": "string" }
            },
            "required": ["path", "method", "operationId", "responseType"]
          }
        },
        "types": {
          "type": "object",
          "description": "Type definitions for the SDK",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "optional": { "type": "boolean" }
                  },
                  "required": ["name", "type"]
                }
              }
            },
            "required": ["fields"]
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["apiKey", "bearer", "oauth2"] },
            "headerName": { "type": "string" }
          },
          "required": ["type"]
        }
      },
      "required": ["name", "version", "description", "language", "baseUrl", "endpoints", "types"]
    },
    "GeneratedFile": {
      "type": "object",
      "title": "GeneratedFile",
      "description": "A file generated by the SDKGenerator",
      "properties": {
        "path": { "type": "string", "description": "Relative file path in the SDK output" },
        "content": { "type": "string", "description": "File content as a string" },
        "language": { "$ref": "#/definitions/Language" }
      },
      "required": ["path", "content", "language"]
    },
    "CLICommand": {
      "type": "object",
      "title": "CLICommand",
      "description": "A registered CLI command",
      "properties": {
        "name": { "type": "string", "description": "Command name (e.g. 'init', 'compile')" },
        "description": { "type": "string", "description": "Command description for help text" },
        "usage": { "type": "string", "description": "Usage syntax string" },
        "options": {
          "type": "array",
          "description": "Command-line options/flags",
          "items": {
            "type": "object",
            "properties": {
              "flag": { "type": "string" },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "default": { "type": "string" }
            },
            "required": ["flag", "description"]
          }
        },
        "args": {
          "type": "array",
          "description": "Positional arguments",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "required": ["name", "description"]
          }
        }
      },
      "required": ["name", "description", "usage"]
    },
    "CLIOutput": {
      "type": "object",
      "title": "CLIOutput",
      "description": "The result of executing a CLI command",
      "properties": {
        "command": { "type": "string", "description": "Name of the command that was executed" },
        "success": { "type": "boolean", "description": "Whether the command succeeded" },
        "data": { "description": "Result data on success" },
        "error": { "type": "string", "description": "Error message on failure" },
        "duration": { "type": "number", "description": "Execution duration in milliseconds" },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of execution"
        }
      },
      "required": ["command", "success", "duration", "timestamp"]
    },
    "PackageType": {
      "type": "string",
      "title": "PackageType",
      "description": "Types of packages in the Registry",
      "enum": ["pattern", "plugin", "engine", "skill", "template"]
    },
    "PackageVersion": {
      "type": "object",
      "title": "PackageVersion",
      "description": "A specific version entry in the Registry",
      "properties": {
        "version": { "type": "string", "description": "Semver version string" },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 publish timestamp"
        },
        "description": { "type": "string", "description": "Version-specific description" },
        "dependencies": {
          "type": "array",
          "description": "Package dependencies",
          "items": {
            "type": "object",
            "properties": {
              "packageId": { "type": "string" },
              "version": { "type": "string" }
            },
            "required": ["packageId", "version"]
          }
        },
        "changelog": { "type": "string", "description": "Changelog for this version" }
      },
      "required": ["version", "publishedAt"]
    },
    "PackageInfo": {
      "type": "object",
      "title": "PackageInfo",
      "description": "A registered package in the Registry",
      "properties": {
        "id": { "type": "string", "description": "Unique package identifier" },
        "name": { "type": "string", "description": "Package name" },
        "type": { "$ref": "#/definitions/PackageType" },
        "latestVersion": { "type": "string", "description": "Latest published version" },
        "versions": {
          "type": "array",
          "description": "All published versions",
          "items": { "$ref": "#/definitions/PackageVersion" }
        },
        "author": { "type": "string", "description": "Package author" },
        "license": { "type": "string", "description": "Package license (e.g. MIT, Apache-2.0)" },
        "repository": { "type": "string", "format": "uri", "description": "Source repository URL" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Categorization tags"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last update"
        }
      },
      "required": [
        "id",
        "name",
        "type",
        "latestVersion",
        "versions",
        "tags",
        "createdAt",
        "updatedAt"
      ]
    },
    "Listing": {
      "type": "object",
      "title": "Listing",
      "description": "A marketplace listing for a package",
      "properties": {
        "packageId": { "type": "string", "description": "ID of the listed package" },
        "featured": { "type": "boolean", "description": "Whether the listing is featured" },
        "category": { "type": "string", "description": "Marketplace category" },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Average rating (0-5)"
        },
        "reviewCount": { "type": "integer", "minimum": 0, "description": "Number of reviews" },
        "installCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of installations"
        },
        "verified": { "type": "boolean", "description": "Whether the package is verified" },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when listed"
        }
      },
      "required": [
        "packageId",
        "featured",
        "category",
        "rating",
        "reviewCount",
        "installCount",
        "verified",
        "addedAt"
      ]
    },
    "Review": {
      "type": "object",
      "title": "Review",
      "description": "A user review for a marketplace package",
      "properties": {
        "id": { "type": "string", "description": "Unique review identifier" },
        "packageId": { "type": "string", "description": "Reviewed package ID" },
        "userId": { "type": "string", "description": "Reviewer user ID" },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "description": "Rating score (0-5)"
        },
        "title": { "type": "string", "description": "Review title" },
        "content": { "type": "string", "description": "Review body content" },
        "createdAt": {
          "type": "string",
